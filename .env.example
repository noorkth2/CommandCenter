# Supabase — copy from your project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App metadata
VITE_APP_NAME=CommandCenter
VITE_APP_VERSION=1.0.0

# NOTE: Claude API key and SMTP credentials are stored in the Supabase
# settings table and configured from the Settings UI — NOT here.
# This prevents secrets from appearing in environment logs.
